{
  "info": {
    "_postman_id": "6d70b8cf-80df-4f20-9df2-7a3f7df4f101",
    "name": "Strategic Risk Radar - Guardian News",
    "description": "Tests the Guardian Open Platform API source used by Strategic Risk Radar. The collection searches a configurable UTC lookback window, requests English articles, and includes the five project keyword groups.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const end = new Date();",
          "const start = new Date(end.getTime() - Number(pm.collectionVariables.get('lookbackHours')) * 60 * 60 * 1000);",
          "const guardianDate = date => date.toISOString().slice(0, 10);",
          "pm.collectionVariables.set('fromDate', guardianDate(start));",
          "pm.collectionVariables.set('toDate', guardianDate(end));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP status is 200', function () {",
          "  pm.response.to.have.status(200);",
          "});",
          "pm.test('Guardian response is successful', function () {",
          "  const json = pm.response.json();",
          "  pm.expect(json.response.status).to.eql('ok');",
          "  pm.expect(json.response.results).to.be.an('array');",
          "});",
          "pm.test('Shows result count for quick inspection', function () {",
          "  const json = pm.response.json();",
          "  console.log('Guardian results:', json.response.results.length, 'total:', json.response.total);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://content.guardianapis.com/search"
    },
    {
      "key": "apiKey",
      "value": "test"
    },
    {
      "key": "keyword",
      "value": "military escalation"
    },
    {
      "key": "lookbackHours",
      "value": "24"
    },
    {
      "key": "pageSize",
      "value": "50"
    },
    {
      "key": "fromDate",
      "value": ""
    },
    {
      "key": "toDate",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Single Configurable Keyword",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}?q={{keyword}}&api-key={{apiKey}}&lang=en&from-date={{fromDate}}&to-date={{toDate}}&order-by=newest&page-size={{pageSize}}&show-fields=trailText,bodyText,shortUrl,headline",
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "key": "q",
              "value": "{{keyword}}"
            },
            {
              "key": "api-key",
              "value": "{{apiKey}}"
            },
            {
              "key": "lang",
              "value": "en"
            },
            {
              "key": "from-date",
              "value": "{{fromDate}}"
            },
            {
              "key": "to-date",
              "value": "{{toDate}}"
            },
            {
              "key": "order-by",
              "value": "newest"
            },
            {
              "key": "page-size",
              "value": "{{pageSize}}"
            },
            {
              "key": "show-fields",
              "value": "trailText,bodyText,shortUrl,headline"
            }
          ]
        }
      }
    },
    {
      "name": "Project Keyword Groups",
      "item": [
        {
          "name": "Conflict Escalation",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}?q=(Iran%20OR%20Tehran%20OR%20%22Middle%20East%22%20OR%20Israel%20OR%20Lebanon%20OR%20Syria%20OR%20Yemen)%20AND%20(war%20OR%20conflict%20OR%20attack%20OR%20strikes%20OR%20ceasefire%20OR%20escalation%20OR%20sanctions)&api-key={{apiKey}}&lang=en&from-date={{fromDate}}&to-date={{toDate}}&order-by=newest&page-size={{pageSize}}&show-fields=trailText,bodyText,shortUrl,headline"
          }
        },
        {
          "name": "Maritime and Cargo Disruption",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}?q=(%22Strait%20of%20Hormuz%22%20OR%20Hormuz%20OR%20%22Red%20Sea%22%20OR%20shipping%20OR%20cargo%20OR%20vessel%20OR%20tanker%20OR%20port)%20AND%20(attack%20OR%20disruption%20OR%20seized%20OR%20closure%20OR%20blockade%20OR%20sanctions)&api-key={{apiKey}}&lang=en&from-date={{fromDate}}&to-date={{toDate}}&order-by=newest&page-size={{pageSize}}&show-fields=trailText,bodyText,shortUrl,headline"
          }
        },
        {
          "name": "Aviation and Passenger Disruption",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}?q=(airspace%20OR%20airport%20OR%20flight%20OR%20airline%20OR%20passenger%20OR%20aviation)%20AND%20(closure%20OR%20suspension%20OR%20cancelled%20OR%20cancellation%20OR%20disruption%20OR%20reroute)&api-key={{apiKey}}&lang=en&from-date={{fromDate}}&to-date={{toDate}}&order-by=newest&page-size={{pageSize}}&show-fields=trailText,bodyText,shortUrl,headline"
          }
        },
        {
          "name": "Migration and Residency Pressure",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}?q=(refugee%20OR%20refugees%20OR%20migrant%20OR%20migrants%20OR%20asylum%20OR%20displacement%20OR%20visa%20OR%20residency)%20AND%20(influx%20OR%20border%20OR%20suspension%20OR%20expired%20OR%20overstay%20OR%20deportation)&api-key={{apiKey}}&lang=en&from-date={{fromDate}}&to-date={{toDate}}&order-by=newest&page-size={{pageSize}}&show-fields=trailText,bodyText,shortUrl,headline"
          }
        },
        {
          "name": "Identity and Border Crime",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}?q=(%22travel%20document%22%20OR%20passport%20OR%20visa%20OR%20identity%20OR%20border%20OR%20trafficking%20OR%20smuggling)%20AND%20(fraud%20OR%20fraudulent%20OR%20forged%20OR%20fake%20OR%20illegal)&api-key={{apiKey}}&lang=en&from-date={{fromDate}}&to-date={{toDate}}&order-by=newest&page-size={{pageSize}}&show-fields=trailText,bodyText,shortUrl,headline"
          }
        }
      ]
    }
  ]
}
