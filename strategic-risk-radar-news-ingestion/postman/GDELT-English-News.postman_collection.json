{
  "info": {
    "_postman_id": "839d48d1-2512-45a0-a6e8-ea94001f5246",
    "name": "Strategic Risk Radar - GDELT English News",
    "description": "Tests the GDELT DOC 2.0 API used by Strategic Risk Radar. The collection automatically searches the latest 24-hour UTC window and restricts results to English sources. When running multiple requests, configure a delay of at least 6000 ms to reduce GDELT HTTP 429 responses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const end = new Date();",
          "const start = new Date(end.getTime() - Number(pm.collectionVariables.get('lookbackHours')) * 60 * 60 * 1000);",
          "const gdeltDate = date => date.toISOString().replace(/[-:TZ.]/g, '').slice(0, 14);",
          "pm.collectionVariables.set('startdatetime', gdeltDate(start));",
          "pm.collectionVariables.set('enddatetime', gdeltDate(end));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.gdeltproject.org/api/v2/doc/doc"
    },
    {
      "key": "keyword",
      "value": "military escalation"
    },
    {
      "key": "lookbackHours",
      "value": "24"
    },
    {
      "key": "maxrecords",
      "value": "50"
    },
    {
      "key": "startdatetime",
      "value": ""
    },
    {
      "key": "enddatetime",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Single Configurable Keyword",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}?query=%22{{keyword}}%22%20sourcelang%3Aenglish&mode=artlist&format=json&maxrecords={{maxrecords}}&startdatetime={{startdatetime}}&enddatetime={{enddatetime}}&sort=datedesc",
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "key": "query",
              "value": "\"{{keyword}}\" sourcelang:english"
            },
            {
              "key": "mode",
              "value": "artlist"
            },
            {
              "key": "format",
              "value": "json"
            },
            {
              "key": "maxrecords",
              "value": "{{maxrecords}}"
            },
            {
              "key": "startdatetime",
              "value": "{{startdatetime}}"
            },
            {
              "key": "enddatetime",
              "value": "{{enddatetime}}"
            },
            {
              "key": "sort",
              "value": "datedesc"
            }
          ]
        },
        "description": "Change the collection variable `keyword` to test one keyword at a time."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Response contains an articles array', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.articles).to.be.an('array');",
              "});",
              "pm.test('Returned articles are English', () => {",
              "  const articles = pm.response.json().articles || [];",
              "  articles.forEach(article => pm.expect((article.language || '').toLowerCase()).to.eql('english'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Project Keyword Groups - Run With 6000 ms Delay",
      "item": [
        {
          "name": "Conflict Escalation",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}?query=%28%22military%20escalation%22%20OR%20%22conflict%20escalation%22%20OR%20%22hostilities%20intensify%22%29%20sourcelang%3Aenglish&mode=artlist&format=json&maxrecords={{maxrecords}}&startdatetime={{startdatetime}}&enddatetime={{enddatetime}}&sort=datedesc"
          }
        },
        {
          "name": "Maritime and Cargo Disruption",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}?query=%28%22attack%20on%20commercial%20shipping%22%20OR%20%22vessel%20seized%22%20OR%20%22shipping%20lane%20closure%22%20OR%20%22port%20closure%22%20OR%20%22no%20safe%20transit%22%29%20sourcelang%3Aenglish&mode=artlist&format=json&maxrecords={{maxrecords}}&startdatetime={{startdatetime}}&enddatetime={{enddatetime}}&sort=datedesc"
          }
        },
        {
          "name": "Aviation and Passenger Disruption",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}?query=%28%22airspace%20closure%22%20OR%20%22airport%20closure%22%20OR%20%22flight%20suspension%22%20OR%20%22mass%20flight%20cancellation%22%29%20sourcelang%3Aenglish&mode=artlist&format=json&maxrecords={{maxrecords}}&startdatetime={{startdatetime}}&enddatetime={{enddatetime}}&sort=datedesc"
          }
        },
        {
          "name": "Migration and Residency Pressure",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}?query=%28%22refugee%20influx%22%20OR%20%22cross-border%20displacement%22%20OR%20%22mass%20arrival%22%20OR%20%22visa%20suspension%22%29%20sourcelang%3Aenglish&mode=artlist&format=json&maxrecords={{maxrecords}}&startdatetime={{startdatetime}}&enddatetime={{enddatetime}}&sort=datedesc"
          }
        },
        {
          "name": "Identity and Border Crime",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}?query=%28%22travel%20document%20fraud%22%20OR%20%22fraudulent%20passport%22%20OR%20%22migrant%20smuggling%22%20OR%20%22human%20trafficking%22%29%20sourcelang%3Aenglish&mode=artlist&format=json&maxrecords={{maxrecords}}&startdatetime={{startdatetime}}&enddatetime={{enddatetime}}&sort=datedesc"
          }
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Response contains an articles array', () => pm.expect(pm.response.json().articles).to.be.an('array'));",
              "pm.test('Returned articles are English', () => {",
              "  const articles = pm.response.json().articles || [];",
              "  articles.forEach(article => pm.expect((article.language || '').toLowerCase()).to.eql('english'));",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
